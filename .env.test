# Environment used by the test suite. Safe to commit: every value here points to the local
# docker-compose stack or is a throwaway test value.
#
# Precedence is: process environment variables, then this file. The CI workflow sets
# PG_COMPONENT_PSQL_CONNECTION_STRING for its own postgres service, so it overrides the one below.

# default db from docker-compose.yml
PG_COMPONENT_PSQL_CONNECTION_STRING=postgres://postgres:pass1234@localhost:5454/db

# Goerli is used because it has a deployed Rentals contract, needed to verify listing signatures
CHAIN_NAME=Goerli
MAX_CONCURRENT_RENTAL_UPDATES=5

# The subgraphs are always stubbed in tests, these are never called
MARKETPLACE_SUBGRAPH_URL=https://marketplace-subgraph.test
RENTALS_SUBGRAPH_URL=https://rentals-subgraph.test

CORS_ORIGIN=.*
CORS_METHODS=GET,POST,PATCH,OPTIONS
LOG_LEVEL=ERROR
